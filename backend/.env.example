DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/legalmind

# Company-hosted embedding + LLM API, OpenAI-compatible (LiteLLM gateway).
# Ask the team for the real values - do not commit real credentials here.
COMPANY_API_URL=https://example.invalid
COMPANY_API_KEY=sk-changeme
COMPANY_EMBEDDING_MODEL=bge-m3
COMPANY_LLM_MODEL=gemma4

# Lets the RAG graph decompose a compound question and retrieve in several
# passes. Off unless set to 1/true/yes/on. Currently off because the reason
# node restates rather than decomposes, and the extra passages it retrieves
# have been measured making answers worse, not better - see
# graph.builder.multi_step_enabled.
RAG_MULTI_STEP_ENABLED=false
