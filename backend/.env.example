DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/legalmind

# Where this instance is running: development or production. Anything else is
# rejected at startup rather than guessed at. Unset means development.
#
# The only thing it currently decides is whether the session cookie carries the
# Secure attribute, which must be off for local work: a Secure cookie is not
# stored by a browser over plain HTTP unless the origin is localhost, so with it
# on, reaching the app from another machine over a LAN address logs you straight
# back out. See foundation/settings.py.
ENVIRONMENT=development

# How often the ingestion worker deletes expired sessions, in whole minutes.
# Optional - defaults to 60. Sessions are already unusable the moment they
# expire, so this only decides how long dead rows linger; nothing observable
# depends on the number. There is no "off" value: stop the worker instead.
# SESSION_REAP_INTERVAL_MINUTES=60

# Company-hosted embedding + LLM API, OpenAI-compatible (LiteLLM gateway).
# Ask the team for the real values - do not commit real credentials here.
COMPANY_API_URL=https://example.invalid
COMPANY_API_KEY=sk-changeme
COMPANY_EMBEDDING_MODEL=bge-m3
COMPANY_LLM_MODEL=gemma4

# Lets the RAG graph decompose a compound question and retrieve in several
# passes. Off unless set to 1/true/yes/on. Currently off because the reason
# node restates rather than decomposes, and the extra passages it retrieves
# have been measured making answers worse, not better - see
# graph.builder.multi_step_enabled.
RAG_MULTI_STEP_ENABLED=false

# Where uploaded documents are written. Optional - defaults to
# backend/storage/documents, resolved absolutely, so the API and the ingestion
# worker agree on the root no matter which directory each was started from.
# Set it when the two run in separate containers: both must point at the same
# mounted volume, or uploads will never become searchable.
# STORAGE_DIR=/app/storage/documents

# Langfuse tracing (LEG-83). Entirely optional: with the two keys blank the
# app records nothing and behaves exactly as it does without Langfuse
# installed, which is how CI runs.
#
# LANGFUSE_BASE_URL must name a Langfuse you control. If the keys are set and
# this is not, the app refuses to trace rather than falling back to the SDK's
# default of cloud.langfuse.com - traced prompts carry verbatim case-document
# text, and that does not go to a third party. See docker-compose.langfuse.yml
# for running one locally.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3001
